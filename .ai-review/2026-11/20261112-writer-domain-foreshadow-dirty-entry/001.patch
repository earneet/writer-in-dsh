diff --git a/packages/writer-domain/src/index.ts b/packages/writer-domain/src/index.ts
index 3a1e11e..ca07dec 100644
--- a/packages/writer-domain/src/index.ts
+++ b/packages/writer-domain/src/index.ts
@@ -134,8 +134,11 @@ export const FORESHADOW_TRANSITIONS: Readonly<Record<ForeshadowStatus, readonly
 
 /** 校验并执行状态迁移；非法迁移抛错（调用方反馈为业务错误，不熔断）。 */
 export function transitionForeshadow(from: ForeshadowStatus, to: ForeshadowStatus): ForeshadowStatus {
-  if (!FORESHADOW_TRANSITIONS[from].includes(to)) {
-    throw new Error(`伏笔状态非法迁移：${from} → ${to}`)
+  // 未知 from 状态（frontmatter status 被手编/模型误写为 "Planted"/"draft" 等）查表得
+  // undefined——原实现直接 .includes 抛原生 TypeError，guard 分类逃逸且模型拿不到纠偏指引
+  const allowed = FORESHADOW_TRANSITIONS[from] ?? []
+  if (!allowed.includes(to)) {
+    throw new Error(`伏笔状态非法迁移：${String(from)} → ${String(to)}（合法状态：planned / planted / resolved / abandoned）`)
   }
   return to
 }
