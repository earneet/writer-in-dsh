+test('appendPending/archivePending：pending.md 读失败（非 ENOENT）响亮拒绝，不按空文本静默重写', async () => {
+  const { store, root } = await makeStore()
+  try {
+    // 目录占位 pending.md 路径：readFile 得 EISDIR（非 ENOENT 的 IO 错误）
+    // 修复前被静默当「首次创建」，以仅含新节的全文重写——既有待办全部消失且零报错
+    await mkdir(join(root, 'pending.md'), { recursive: true })
+    await assert.rejects(() => store.appendPending('## 新节'), /pending\.md 读取失败/)
+    await assert.rejects(
+      () => store.archivePending(() => ({ next: '', extracted: 'x' })),
+      /pending\.md 读取失败/,
+    )
+  } finally {
+    await rm(root, { recursive: true, force: true })
+  }
+})
+
