+
+test('maintenancePass：appendPending 失败回滚派生记录——待办不因提交点先行而永久丢失', async () => {
+  const setup = await makeSetup()
+  try {
+    await seedChapter(setup, '001', '正文。')
+    await seedRefs(setup)
+    setup.llm.reply('摘要一。', JSON.stringify({ facts: [], foreshadowEvents: [], characterStates: [] }))
+    // 首次 appendPending 失败（如 rename 重试耗尽/IO 故障），第二次恢复正常
+    const originalAppend = setup.store.appendPending.bind(setup.store)
+    let failOnce = true
+    setup.store.appendPending = async (section: string): Promise<void> => {
+      if (failOnce) {
+        failOnce = false
+        throw new Error('模拟：pending.md 追加失败')
+      }
+      return originalAppend(section)
+    }
+    // 修复前：派生已锚定 sourceHash，appendPending 抛错后重试命中 up-to-date 短路——待办永久缺席
+    await assert.rejects(() => setup.engine.maintenancePass('001'), /模拟：pending\.md 追加失败/)
+    assert.equal(await setup.store.readMaintenance('001'), undefined, '失败后派生记录已回滚（下次触发重跑全 pass）')
+    setup.llm.reply('摘要二。', JSON.stringify({ facts: [], foreshadowEvents: [], characterStates: [] }))
+    const retried = await setup.engine.maintenancePass('001')
+    assert.equal(retried.status, 'done', '回滚后重试真正重跑（而非 up-to-date 短路 no-op）')
+    assert.equal(setup.llm.calls, 4, '两次完整 pass 各 2 次调用')
+    const pending = await readFile(join(setup.root, 'pending.md'), 'utf8')
+    assert.match(pending, /摘要二/, '重跑轮待办已落清单')
+  } finally {
+    await rm(setup.root, { recursive: true, force: true })
+  }
+})
