+ * 解析 frontmatter 里的章节锚（三位序号字符串或数字）；缺失/脏值返回 undefined
  * （按缺失处理：伏笔红线不因脏数据静默误判，也不因脏数据误触发）。
+ * 脏值除 NaN 外显式拒绝布尔与空串——Number(true)=1、Number('')=0 都是有限数，
+ * 会把不可解析锚伪造成 0/1 号章，使「已逾期」红线自此后的每一章误触发。
  */
-function chapterAnchorOf(value: FrontmatterValue | undefined): number | undefined {
+export function chapterAnchorOf(value: FrontmatterValue | undefined): number | undefined {
   if (value === undefined) return undefined
+  if (typeof value === 'boolean') return undefined
+  if (typeof value === 'string' && value.trim().length === 0) return undefined
   const n = Number(value)
   return Number.isFinite(n) ? n : undefined
 }
