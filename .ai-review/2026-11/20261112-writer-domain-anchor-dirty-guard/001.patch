+test('assembleWritingContext：planned_chapter 布尔/空串脏值不得经 Number() 伪造成 0/1 号锚（假逾期红线）', () => {
+  // Number(true)=1、Number('')=0 均为有限数——修复前绕过 isFinite 脏值闸，
+  // 使 planned 伏笔自第 2 章起每章注入「🔴 已逾期未设置，本章必须设置」假红线
+  const boolAnchor = entity('plot', 'b-anch', { status: 'planned', planned_chapter: true }, '布尔锚伏笔。')
+  const emptyAnchor = entity('plot', 'e-anch', { status: 'planned', planned_chapter: '' }, '空串锚伏笔。')
+  for (const plot of [boolAnchor, emptyAnchor]) {
+    const r = assembleWritingContext({
+      chapterNumber: 3,
+      principles, outline,
+      chapters: [],
+      characters: [],
+      plots: [plot],
+      budgetChars: 5000,
+    })
+    const body = r.sections.find((s) => s.title === '伏笔指令')!.body
+    assert.ok(!body.includes('🔴'), `${plot.id} 布尔/空串锚按缺失处理，不触发假逾期红线`)
+    assert.ok(body.includes('🟡'), `${plot.id} 仍以活跃伏笔注入（黄档，不因脏值丢失伏笔）`)
+  }
+})
